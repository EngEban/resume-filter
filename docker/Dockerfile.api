# ============================================================
# ResumeFilter - FastAPI Dockerfile
# Multi-stage build for smaller production image
# ============================================================

# ---------- Stage 1: Builder ----------
FROM python:3.12-slim AS builder

WORKDIR /app

# تثبيت أدوات البناء المؤقتة
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# إنشاء virtualenv
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# ترقية pip وتثبيت المكتبات
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ---------- Stage 2: Production ----------
FROM python:3.12-slim AS production

WORKDIR /app

# تثبيت مكتبات النظام المطلوبة وقت التشغيل
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    tesseract-ocr \
    tesseract-ocr-ara \
    && rm -rf /var/lib/apt/lists/*

# نسخ virtualenv من المرحلة الأولى
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# مستخدم غير root للأمان
RUN useradd --create-home --shell /bin/bash appuser

# نسخ الكود
COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

# الأمر الافتراضي (يمكن تجاوزه من docker-compose)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]