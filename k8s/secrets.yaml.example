# ============================================================
# ResumeFilter - Sensitive Configuration (TEMPLATE)
# ============================================================
# DO NOT commit the real secrets.yaml to version control.
#
# To create the actual Secret:
#   kubectl create secret generic resume-filter-secrets \
#     --namespace resume-filter \
#     --from-literal=SECRET_KEY="$(python -c 'import secrets; print(secrets.token_urlsafe(64))')" \
#     --from-literal=MASTER_KEY="$(python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')" \
#     --from-literal=POSTGRES_PASSWORD="your-db-password" \
#     --from-literal=MINIO_ROOT_USER="minioadmin" \
#     --from-literal=MINIO_ROOT_PASSWORD="your-minio-password" \
#     --from-literal=MINIO_ACCESS_KEY="minioadmin" \
#     --from-literal=MINIO_SECRET_KEY="your-minio-password" \
#     --from-literal=PLATFORM_LLM_API_KEY="gsk_xxxxx" \
#     --from-literal=UI_STORAGE_SECRET="$(python -c 'import secrets; print(secrets.token_urlsafe(32))')"
#
# Or apply this YAML after filling in the values (base64-encoded).
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: resume-filter-secrets
  namespace: resume-filter
  labels:
    app.kubernetes.io/name: resume-filter
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # ---------- Application ----------
  SECRET_KEY: "replace-with-64-char-random-string"
  MASTER_KEY: "replace-with-fernet-key"

  # ---------- Database ----------
  POSTGRES_PASSWORD: "replace-with-strong-password"

  # ---------- MinIO ----------
  MINIO_ROOT_USER: "minioadmin"
  MINIO_ROOT_PASSWORD: "replace-with-strong-password"
  MINIO_ACCESS_KEY: "minioadmin"
  MINIO_SECRET_KEY: "replace-with-strong-password"

  # ---------- Platform LLM ----------
  PLATFORM_LLM_API_KEY: "gsk_replace-with-real-key"

  # ---------- UI ----------
  UI_STORAGE_SECRET: "replace-with-32-char-random-string"