# ============================================================
# ResumeFilter - Secret Template
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: resume-filter-secrets
  namespace: resume-filter
  labels:
    app.kubernetes.io/name: resume-filter
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  SECRET_KEY: "replace-with-64-char-random-string"
  MASTER_KEY: "replace-with-fernet-key"

  POSTGRES_PASSWORD: "replace-with-strong-password"
  DATABASE_URL: "postgresql+asyncpg://rf_user:replace-with-strong-password@resume-filter-postgres:5432/rf_db"

  S3_ACCESS_KEY: "minioadmin"
  S3_SECRET_KEY: "replace-with-strong-password"

  PLATFORM_LLM_API_KEY: "gsk_replace-with-real-key"
  UI_STORAGE_SECRET: "replace-with-32-char-random-string"
