# ============================================================
# ResumeFilter - Secret Template
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: resume-filter-secrets
  namespace: resume-filter
  labels:
    app.kubernetes.io/name: resume-filter
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  SECRET_KEY: "replace-with-64-char-random-string"
  MASTER_KEY: "replace-with-fernet-key"

  S3_ACCESS_KEY: "minioadmin"
  S3_SECRET_KEY: "replace-with-strong-password"

  PLATFORM_LLM_API_KEY: "gsk_replace-with-real-key"
  UI_STORAGE_SECRET: "replace-with-32-char-random-string"

---
apiVersion: v1
kind: Secret
metadata:
  name: resume-filter-db-secrets
  namespace: resume-filter
  labels:
    app.kubernetes.io/name: resume-filter
    app.kubernetes.io/component: database-secrets
type: Opaque
stringData:
  # Bootstrap access is used only by PostgreSQL and provisioning Jobs.
  POSTGRES_BOOTSTRAP_PASSWORD: ""

  # Runtime and migration credentials are injected only into their matching Pods.
  RF_APP_PASSWORD: ""
  RF_WORKER_PASSWORD: ""
  RF_MIGRATOR_PASSWORD: ""
  API_DATABASE_URL: ""
  WORKER_DATABASE_URL: ""
  MIGRATOR_DATABASE_URL: ""
