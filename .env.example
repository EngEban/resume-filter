# ============================================================
# ResumeFilter - Environment Variables Template
# ============================================================
# Copy this file to .env and edit the values:
#   copy .env.example .env
# ============================================================

# ---------- Application ----------
APP_NAME=ResumeFilter
APP_ENV=development
DEBUG=true

# Secret key for signing JWTs (64+ random chars).
# Generate with: python scripts/generate_master_key.py
SECRET_KEY=change-me-to-a-random-64-char-string-please

# Fernet key for encrypting tenant API keys.
# Generate with: python scripts/generate_master_key.py
MASTER_KEY=change-me-to-a-fernet-key-please

# ---------- Database ----------
POSTGRES_USER=rf_user
POSTGRES_PASSWORD=rf_pass
POSTGRES_DB=rf_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rf_user:rf_pass@postgres:5432/rf_db

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# ---------- MinIO / S3 ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes
MINIO_SECURE=false

# ---------- Platform Default LLM ----------
# Used when a tenant has not configured its own key.
# LiteLLM format: <provider>/<model>
#
# Supported providers: groq, openai, anthropic, gemini, azure, bedrock, ollama
#
# Examples:
#   groq/llama-3.3-70b-versatile
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-20250514
#   gemini/gemini-1.5-flash
#   ollama/llama3.1:8b
PLATFORM_LLM_PROVIDER=groq
PLATFORM_LLM_MODEL=groq/llama-3.1-8b-instant
PLATFORM_LLM_API_KEY=your-groq-api-key-here
PLATFORM_LLM_BASE_URL=

# ---------- Ollama (local fallback) ----------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- Limits ----------
B2C_DAILY_LIMIT=3
B2C_PLATFORM_MONTHLY_LIMIT=50
B2B_MAX_BATCH_SIZE=500
B2B_MAX_FILE_SIZE_MB=10

# ---------- Rate Limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_B2C_ANALYZE=5/minute
RATE_LIMIT_B2B_UPLOAD=20/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------- Frontend / CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- UI ----------
# Secret used by NiceGUI to sign session cookies.
# Generate a random value before deploying to production.
UI_STORAGE_SECRET=change-me-to-a-random-32-char-string

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=false