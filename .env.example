# ============================================================
# ResumeFilter - Environment Variables Template
# ============================================================
# Copy this file to .env and edit the values:
#   copy .env.example .env
# ============================================================

# ---------- Application ----------
APP_NAME=ResumeFilter
APP_ENV=development
DEBUG=true

# Secret key for signing JWTs (64+ random chars).
# Generate with: python scripts/generate_master_key.py
SECRET_KEY=change-me-to-a-random-64-char-string-please

# Fernet key for encrypting tenant API keys.
# Generate with: python scripts/generate_master_key.py
MASTER_KEY=change-me-to-a-fernet-key-please

# ---------- Database ----------
POSTGRES_USER=rf_user
POSTGRES_PASSWORD=
POSTGRES_DB=rf_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Runtime and migration role passwords. Set these only in the local .env.
RF_APP_PASSWORD=
RF_WORKER_PASSWORD=
RF_MIGRATOR_PASSWORD=

# Each service receives a URL for its own role. Do not commit real URLs.
API_DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATOR_DATABASE_URL=
DATABASE_URL=

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# ---------- Object Storage (SeaweedFS, S3-compatible) ----------
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=any-key
S3_SECRET_KEY=any-secret
S3_BUCKET=resumes
S3_SECURE=false
S3_REGION=us-east-1

# ---------- Central Platform LLM ----------
# Used for every B2B, B2C, and Celery LLM request.
# LiteLLM format: <provider>/<model>
#
# Supported providers: groq, openai, anthropic, gemini, azure, bedrock, ollama
#
# Examples:
#   groq/llama-3.3-70b-versatile
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-20250514
#   gemini/gemini-1.5-flash
#   ollama/llama3.1:8b
PLATFORM_LLM_PROVIDER=groq
PLATFORM_LLM_MODEL=groq/llama-3.1-8b-instant
PLATFORM_LLM_API_KEY=your-groq-api-key-here
PLATFORM_LLM_BASE_URL=


# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SESSION_SECRET=

# ---------- Limits ----------
B2C_DAILY_LIMIT=3
B2C_PLATFORM_MONTHLY_LIMIT=50
B2B_MAX_BATCH_SIZE=500
B2B_MAX_FILE_SIZE_MB=10

# ---------- Rate Limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_B2C_ANALYZE=5/minute
RATE_LIMIT_B2B_UPLOAD=20/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------- Frontend / CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=false
